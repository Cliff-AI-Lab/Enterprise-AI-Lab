OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=<your-openclaw-gateway-token>
RUIDONG_API_KEY=<your-ruidong-api-key>
TELEGRAM_AGENT_DB=./data/telegram-agent.sqlite
PROJECT_ROOT=<absolute-path-to-TelegramAgent>
PORT=18791

# Optional but recommended for local tester machines:
TELEGRAM_AGENT_TZ=Asia/Shanghai
TELEGRAM_AGENT_MOMENTS_CRON=0
TELEGRAM_AGENT_MEDIA_DIR=./data/media
TELEGRAM_AGENT_POSTS_MEDIA_DIR=./data/posts

# Optional model overrides:
RUIDONG_IMAGE_MODEL=z-image-turbo
RUIDONG_MUSIC_MODEL=ace-step-v15
